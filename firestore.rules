rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // demo prototype: signed-in (anonymous) users can read and write marketplace data
    match /shops/{shopId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // lazy onboarding: owners may only grow the catalog — nothing else is writable
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items']);
      allow delete: if false;
    }
    match /requests/{requestId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
      match /events/{eventId} {
        allow read, create: if request.auth != null;
        allow update, delete: if false;
      }
    }
    // collection-group reads for the shopkeeper activity feed
    match /{path=**}/events/{eventId} {
      allow read: if request.auth != null;
    }
  }
}
