# Copy to frontend/.env for local development
# Firebase web app config (Firebase console -> Project settings -> Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# App Check debug token registered in Firebase console (App Check -> Apps -> Manage debug tokens)
VITE_APPCHECK_DEBUG_TOKEN=
# reCAPTCHA v3 site key for production App Check (optional until deploy)
VITE_RECAPTCHA_SITE_KEY=
